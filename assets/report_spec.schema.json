{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Learning Canvas report specification",
  "type": "object",
  "required": ["version", "topic", "frames", "probes", "own_words", "sources", "rationale"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "enum": ["1.0"]},
    "topic": {"$ref": "#/$defs/text"},
    "subtitle": {"type": "string"},
    "source": {"type": "object", "required": ["path", "sha256"], "additionalProperties": false, "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "[a-f0-9]{64}"}}},
    "frames": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/frame"}},
    "probes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/probe"}},
    "own_words": {"type": "object", "required": ["prompt"], "additionalProperties": false, "properties": {"prompt": {"$ref": "#/$defs/text"}}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "rationale": {"type": "object", "required": ["flow", "frame_method", "theory_map", "prior_art"], "additionalProperties": false, "properties": {
      "flow": {"$ref": "#/$defs/text"}, "frame_method": {"$ref": "#/$defs/text"}, "prior_art": {"$ref": "#/$defs/text"},
      "theory_map": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "application"], "additionalProperties": false, "properties": {"name": {"$ref": "#/$defs/text"}, "application": {"$ref": "#/$defs/text"}}}}
    }},
    "verification": {"type": "object"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "claim": {"type": "object", "required": ["text"], "additionalProperties": false, "properties": {
      "text": {"$ref": "#/$defs/text"}, "anchor": {"type": "string"}, "source_id": {"type": "string", "pattern": "S[1-9][0-9]*"},
      "ai_only": {"type": "boolean"}, "verified": {"type": "boolean"}, "verification_status": {"type": "string", "enum": ["verified", "failed", "ai_only"]}
    }},
    "frame": {"type": "object", "required": ["id", "title", "subtitle", "body", "why", "claims"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "pattern": "F[1-9][0-9]*"}, "title": {"$ref": "#/$defs/text"}, "subtitle": {"type": "string"},
      "body": {"$ref": "#/$defs/text"}, "why": {"$ref": "#/$defs/text"}, "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}}
    }},
    "probe": {"type": "object", "required": ["id", "target", "kind", "prompt", "answer", "explanation"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "pattern": "L[1-9][0-9]*"}, "target": {"type": "string", "pattern": "F[1-9][0-9]*"},
      "kind": {"type": "string", "enum": ["drop", "swap", "overgeneralize"]},
      "prompt": {"$ref": "#/$defs/text"}, "answer": {"$ref": "#/$defs/text"}, "explanation": {"$ref": "#/$defs/text"}, "seed": {"type": "integer"}
    }},
    "source": {"type": "object", "required": ["id", "text"], "additionalProperties": false, "properties": {
      "id": {"type": "string", "pattern": "S[1-9][0-9]*"}, "text": {"$ref": "#/$defs/text"},
      "paragraph_id": {"type": "string", "pattern": "P[0-9]{4,}"}, "line_start": {"type": "integer", "minimum": 1}, "line_end": {"type": "integer", "minimum": 1},
      "verified": {"type": "boolean"}, "verification_status": {"type": "string", "enum": ["verified", "failed"]}
    }}
  }
}
